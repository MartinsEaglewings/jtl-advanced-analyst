* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #070b12;
    --panel: #0d131d;
    --panel-light: #111a27;
    --border: rgba(255,255,255,0.08);
    --text: #f4f7fb;
    --muted: #8d9aaa;
    --accent: #00d9ff;
    --accent-soft: rgba(0,217,255,0.12);
    --success: #29e68a;
    --danger: #ff5d73;
}

body {
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:
        radial-gradient(
            circle at top right,
            rgba(0,217,255,0.10),
            transparent 30%
        ),
        var(--bg);

    color: var(--text);
    min-height: 100vh;
}


.app-shell {
    width: 100%;
    min-height: 100vh;
}


.topbar {
    height: 74px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 5%;

    border-bottom: 1px solid var(--border);

    background: rgba(7,11,18,0.88);

    backdrop-filter: blur(18px);

    position: sticky;
    top: 0;
    z-index: 20;
}


.brand {
    font-size: 20px;
    font-weight: 800;
    letter-spacing: 1px;
}


.brand-subtitle {
    font-size: 9px;
    letter-spacing: 3px;
    color: var(--accent);
    margin-top: 3px;
}


.connection {
    display: flex;
    align-items: center;
    gap: 8px;

    font-size: 10px;
    letter-spacing: 1px;

    color: var(--muted);
}


#connectionDot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--success);

    box-shadow: 0 0 12px var(--success);
}


.dashboard {
    width: min(1180px, 92%);
    margin: auto;
    padding: 55px 0 30px;
}


.hero {
    margin-bottom: 35px;
}


.eyebrow,
.section-label {
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--accent);
    font-weight: 700;
}


.hero h1 {
    font-size: clamp(36px, 7vw, 68px);
    line-height: 1;
    margin: 12px 0 18px;
    max-width: 800px;
}


.hero h1 span {
    color: var(--accent);
}


.hero-text {
    max-width: 600px;
    color: var(--muted);
    line-height: 1.7;
}


.control-panel {
    display: grid;
    grid-template-columns: 1fr 220px auto;
    gap: 15px;

    padding: 20px;

    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 18px;

    margin-bottom: 22px;
}


.field label {
    display: block;

    font-size: 9px;
    letter-spacing: 1.5px;

    color: var(--muted);

    margin-bottom: 8px;
}


.field input,
.field select {
    width: 100%;

    height: 48px;

    padding: 0 15px;

    border-radius: 10px;

    border: 1px solid var(--border);

    background: #080d15;

    color: var(--text);

    outline: none;

    font-size: 14px;
}


.field input:focus,
.field select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
}


#analyzeButton {
    align-self: end;

    height: 48px;

    border: none;
    border-radius: 10px;

    background: var(--accent);

    color: #001016;

    font-weight: 800;

    letter-spacing: .5px;

    padding: 0 25px;

    cursor: pointer;

    transition: .2s;
}


#analyzeButton:hover {
    transform: translateY(-2px);

    box-shadow:
        0 8px 30px rgba(0,217,255,.25);
}


#analyzeButton:disabled {
    opacity: .55;
    cursor: wait;
    transform: none;
}


.market-header {
    display: flex;

    justify-content: space-between;
    align-items: end;

    padding: 28px 5px;

    border-bottom: 1px solid var(--border);
}


.market-symbol {
    font-size: 28px;
    font-weight: 800;
}


.market-meta {
    margin-top: 6px;
    color: var(--muted);
    font-size: 12px;
}


.price-block {
    text-align: right;
}


.price {
    font-size: clamp(30px, 6vw, 48px);
    font-weight: 800;
}


.price-label {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1.5px;
}


.analysis-card,
.chart-card {
    margin-top: 20px;

    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 18px;

    padding: 25px;
}


.analysis-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
}


.analysis-heading h2 {
    margin-top: 8px;
    font-size: 24px;
}


.score-container {
    text-align: center;
}


.score {
    width: 65px;
    height: 65px;

    display: grid;
    place-items: center;

    border: 2px solid var(--accent);

    border-radius: 50%;

    font-size: 20px;
    font-weight: 800;
}


.score-container span {
    display: block;
    margin-top: 6px;

    font-size: 8px;
    letter-spacing: 1px;

    color: var(--muted);
}


.observations {
    margin-top: 25px;

    display: grid;
    gap: 10px;
}


.observation {
    padding: 13px 15px;

    background: var(--panel-light);

    border: 1px solid var(--border);

    border-radius: 10px;

    color: #cbd4df;

    font-size: 13px;
}


.indicator-grid {
    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 15px;

    margin-top: 20px;
}


.indicator-card {
    background: var(--panel);

    border: 1px solid var(--border);

    border-radius: 16px;

    padding: 20px;
}


.indicator-title {
    color: var(--muted);

    font-size: 10px;

    letter-spacing: 1.5px;
}


.indicator-value {
    font-size: 27px;

    font-weight: 800;

    margin: 10px 0;
}


.indicator-description {
    font-size: 10px;
    color: var(--muted);
}


.chart-header {
    display: flex;

    justify-content: space-between;
    align-items: center;

    margin-bottom: 20px;
}


.chart-header h2 {
    margin-top: 7px;
    font-size: 20px;
}


#candleCount {
    color: var(--muted);
    font-size: 11px;
}


.chart-wrapper {
    height: 330px;
    position: relative;
}


.error-box {
    padding: 15px;

    background: rgba(255,93,115,.08);

    border: 1px solid rgba(255,93,115,.25);

    color: #ff9baa;

    border-radius: 12px;

    margin-bottom: 20px;

    font-size: 13px;
}


.hidden {
    display: none;
}


.empty-state {
    color: var(--muted);
    font-size: 13px;
}


footer {
    display: flex;

    justify-content: space-between;

    margin-top: 35px;

    padding: 20px 5px;

    border-top: 1px solid var(--border);

    color: var(--muted);

    font-size: 9px;

    letter-spacing: 1px;
}


@media (max-width: 800px) {

    .dashboard {
        width: 94%;
        padding-top: 35px;
    }

    .control-panel {
        grid-template-columns: 1fr;
    }

    #analyzeButton {
        width: 100%;
    }

    .indicator-grid {
        grid-template-columns:
            repeat(2, 1fr);
    }

}


@media (max-width: 520px) {

    .topbar {
        padding: 0 3%;
    }

    .hero h1 {
        font-size: 40px;
    }

    .market-header {
        align-items: flex-start;
        gap: 15px;
    }

    .price {
        font-size: 30px;
    }

    .indicator-grid {
        grid-template-columns: 1fr;
    }

    .analysis-card,
    .chart-card {
        padding: 18px;
    }

    .chart-wrapper {
        height: 260px;
    }

}
