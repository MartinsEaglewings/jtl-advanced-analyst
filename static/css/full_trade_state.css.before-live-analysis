/* JTL ADVANCED — Full Trade State Dashboard */

.jtl-fts-launch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    max-width: 360px;
    min-height: 48px;
    padding: 13px 18px;
    margin: 12px 0;
    border: 1px solid #d6a84f;
    border-radius: 12px;
    background: linear-gradient(135deg, #291d0a, #111318);
    color: #f4ca72;
    font-weight: 800;
    letter-spacing: .6px;
    cursor: pointer;
    box-shadow: 0 0 18px rgba(214,168,79,.10);
}

.jtl-fts-launch:hover {
    box-shadow: 0 0 24px rgba(214,168,79,.24);
}

#jtlFtsOverlay {
    position: fixed;
    inset: 0;
    z-index: 99998;
    display: none;
    overflow-y: auto;
    padding: 14px;
    background: rgba(4,6,10,.94);
    color: #e9edf5;
    font-family: Arial, sans-serif;
}

#jtlFtsOverlay.jtl-fts-open {
    display: block;
}

.jtl-fts-shell {
    width: 100%;
    max-width: 1250px;
    margin: 0 auto;
    border: 1px solid #343947;
    border-radius: 16px;
    background: #0d1017;
    overflow: hidden;
}

.jtl-fts-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    padding: 18px;
    border-bottom: 1px solid #303543;
    background: linear-gradient(110deg, #18140d, #11151f);
}

.jtl-fts-brand {
    color: #f0c56a;
    font-size: 19px;
    font-weight: 900;
    letter-spacing: .7px;
}

.jtl-fts-subtitle {
    margin-top: 5px;
    color: #98a2b4;
    font-size: 11px;
    letter-spacing: 1px;
}

.jtl-fts-exit {
    padding: 10px 15px;
    border: 1px solid #a94b55;
    border-radius: 9px;
    background: #291419;
    color: #ffb5bd;
    font-weight: 800;
    cursor: pointer;
}

.jtl-fts-content {
    padding: 16px;
}

.jtl-fts-notice {
    padding: 13px;
    margin-bottom: 16px;
    border: 1px solid #66532b;
    border-radius: 10px;
    background: #211b10;
    color: #e9c879;
    font-size: 12px;
    line-height: 1.6;
}

.jtl-fts-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 16px;
}

.jtl-fts-card {
    min-width: 0;
    padding: 15px;
    border: 1px solid #292f3b;
    border-radius: 12px;
    background: linear-gradient(145deg, #151a24, #10131a);
}

.jtl-fts-label {
    color: #929daf;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .8px;
    text-transform: uppercase;
}

.jtl-fts-value {
    margin-top: 10px;
    overflow-wrap: anywhere;
    color: #f1f3f8;
    font-size: 18px;
    font-weight: 800;
}

.jtl-fts-value.gold {
    color: #edc56c;
}

.jtl-fts-value.muted {
    color: #9ba5b6;
}

.jtl-fts-panel {
    margin-top: 14px;
    padding: 16px;
    border: 1px solid #292f3b;
    border-radius: 12px;
    background: #11151d;
}

.jtl-fts-panel h3 {
    margin: 0 0 14px;
    color: #f0c56a;
    font-size: 13px;
    letter-spacing: .8px;
}

.jtl-fts-table-wrap {
    width: 100%;
    overflow-x: auto;
}

.jtl-fts-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    white-space: nowrap;
}

.jtl-fts-table th,
.jtl-fts-table td {
    padding: 12px 10px;
    border-bottom: 1px solid #272d39;
    text-align: left;
}

.jtl-fts-table th {
    color: #9aa5b8;
    font-size: 10px;
    letter-spacing: .5px;
}

.jtl-fts-empty {
    padding: 22px 10px !important;
    color: #929daf;
    text-align: center !important;
    white-space: normal;
}

.jtl-fts-state {
    display: inline-block;
    padding: 6px 9px;
    border: 1px solid #66532b;
    border-radius: 20px;
    background: #211b10;
    color: #e9c879;
    font-size: 10px;
    font-weight: 800;
}

.jtl-fts-events {
    display: grid;
    gap: 9px;
}

.jtl-fts-event {
    padding: 11px;
    border-left: 3px solid #b8954c;
    border-radius: 5px;
    background: #171b24;
    color: #c5ccda;
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
}

.jtl-fts-footer {
    padding: 14px 16px;
    border-top: 1px solid #292f3b;
    color: #818da1;
    font-size: 11px;
    line-height: 1.6;
}

@media (max-width: 760px) {
    #jtlFtsOverlay {
        padding: 6px;
    }

    .jtl-fts-header {
        padding: 14px;
    }

    .jtl-fts-content {
        padding: 10px;
    }

    .jtl-fts-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .jtl-fts-card {
        padding: 12px;
    }

    .jtl-fts-value {
        font-size: 16px;
    }

    .jtl-fts-brand {
        font-size: 16px;
    }
}

@media (max-width: 360px) {
    .jtl-fts-grid {
        grid-template-columns: 1fr;
    }
}
